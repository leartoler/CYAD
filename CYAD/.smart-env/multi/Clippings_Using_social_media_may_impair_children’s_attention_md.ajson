mbedded":true},{"title":"Department of Women’s and Children’s Health","target":"https://ki.se/en/kbh","line":46},{"title":"Samson Nivins","target":"https://ki.se/en/people/samson-nivins","line":46},{"title":"“Digital media, Genetics and Risk for ADHD Symptoms in Children – a Longitudinal Study”","target":"https://doi.org/10.1542/pedsos.2025-000922","line":54}],"metadata":{"title":"Using social media may impair children’s attention","source":"https://news.ki.se/using-social-media-may-impair-childrens-attention","author":["[[Karolinska Institutet]]"],"published":"2025-12-07","created":"2025-12-09","description":"Children who spend a significant amount of time on social media tend to experience a gradual decline in their ability to concentrate. This is according to a comprehensive study from Karolinska Institutet, published in Pediatrics Open Science, where researchers followed more than 8,000 children from around age 10 through age 14.","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"35y7zv","at":1780884512282},"key":"Clippings/Using social media may impair children’s attention.md"},
