ube.com/watch?v=ccrMnVFpWao","target":"https://www.youtube.com/watch?v=ccrMnVFpWao","line":46},{"title":"Here","target":"https://www.youtube.com/watch?v=dbHZsO8hV1E","line":54}],"metadata":{"title":"The Guy Looking To Expose Online Gaming's Worst Jerks","source":"https://kotaku.com/meet-the-guy-looking-to-expose-online-gamings-worst-je-1543059597","author":["[[Evan Narcisse]]"],"published":"2014-03-13","created":"2026-07-14","description":"The guy recording racist and sexist crap in online multiplayer matches know he's going to stop doing it soon. \"I really only play one game these days;","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Clippings/The Guy Looking To Expose Online Gaming's Worst Jerks.md#---frontmatter---": {"path":null,"last_embed":{"hash":"dj9ips","at":1784071466343},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.03754163,0.01801628,-0.02788302,-0.02921506,0.03128633,-0.01405703,0.03330804,0.01761741,0.04204137,0.00261633,0.03370278,-0.05477995,0.00694114,0.02688016,0.03820991,0.01049388,0.01167905,0.00730829,0.03295754,0.02165432,0.08996751,-0.01039441,0.05051839,-0.10453299,0.01472235,-0.02106043,-0.03984161,-0.06373147,-0.09803549,-0.12308308,0.04004728,-0.03154568,0.06333622,0.0303369,-0.00871342,-0.07690325,0.01954984,0.07597554,-0.01471678,-0.00052665,0.02325863,0.00471377,-0.00693421,0.00370461,-0.01381659,-0.00906785,-0.04243915,-0.02287942,0.03362117,-0.03913456,-0.02911416,0.03247659,-0.00299787,-0.02360733,0.04549401,-0.01951353,0.04742688,0.04542964,-0.00944886,0.03175933,0.05302827,-0.03817484,-0.12940671,0.07050779,-0.02008524,0.07642902,-0.02409954,-0.00882186,-0.00709688,0.02342235,-0.02395125,0.02909977,-0.05643344,0.05730068,0.00743411,-0.00689459,0.04238563,0.01000982,-0.03660044,-0.02987971,-0.01212256,-0.01469878,0.01359617,-0.05334758,-0.02820373,-0.0400119,0.01847102,-0.00389794,0.05278475,0.0148678,-0.00491578,0.00171135,0.09226838,-0.00444275,-0.07199804,0.03134691,-0.03207659,0.02694