//x.com/WhiteHouse/status/1905332049021415862?lang=en&ref=404media.co","line":30},{"title":"Star Wars","target":"https://x.com/WhiteHouse/status/1919053040734072844?ref=404media.co","line":30},{"title":"no haber dado permiso a la administración","target":"https://www.bbc.com/news/articles/c8ex9n8gxdwo?ref=404media.co","line":36},{"title":"aparecía","target":"https://www.cnn.com/2025/09/24/politics/theo-von-dhs-deportations?ref=404media.co","line":36},{"title":"retirara el video que usaba su canción «Little Dark Age»","target":"https://www.the-independent.com/news/world/americas/us-politics/ice-removes-mgmt-little-dark-age-b2852325.html?ref=404media.co","line":36},{"title":"música de la banda sonora *de Halo*","target":"https://x.com/DHSgov/status/1983186057798545573?ref=404media.co","line":36},{"title":"la propaganda nazi","target":"https://english.elpais.com/society/2022-12-04/how-nazi-propaganda-dehumanized-jews-to-facilitate-the-holocaust.html?ref=404media.co","line":40},{"title":"declaró que esto marcaba el fin oficial de la guerra de consolas","target":"https://x.com/gamestop/status/1982213786221109263?ref=404media.co","line":46},{"title":"comentaron a Game File","target":"https://www.gamefile.news/p/halo-ice-developers-react?ref=404media.co","line":48},{"title":"al publicar","target":"https://x.com/AngryJoeShow/status/1982879082925990346?ref=404media.co","line":48},{"title":"imagen de Trump","target":"https://x.com/gamestop/status/1982213786221109263/quotes?ref=404media.co","line":48},{"title":"prometió «destruir la inundación»","target":"https://x.com/MartyTheElder/status/1982893099316850782?ref=404media.co","line":48},{"title":"atribuyó a Trump el mérito","target":"https://x.com/RapidResponse47/status/1982587953676247375?ref=404media.co","line":48},{"title":"declaró el subsecretario de prensa de la Casa Blanca, Kush Desai, a Mercante por correo electrónico","target":"https://www.patreon.com/posts/exclusive-white-142217261?ref=404media.co","line":50}],"metada