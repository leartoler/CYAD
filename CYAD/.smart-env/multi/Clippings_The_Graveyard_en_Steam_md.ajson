on/?snr=1_5_9__408","line":40},{"title":"Tale of Tales","target":"https://store.steampowered.com/search/?developer=Tale%20of%20Tales&snr=1_5_9__408","line":42},{"title":"Tale of Tales","target":"https://store.steampowered.com/search/?publisher=Tale%20of%20Tales&snr=1_5_9__422","line":44},{"title":"Buscar grupos de la comunidad","target":"https://steamcommunity.com/actions/Search?T=ClanAccount&K=The%20Graveyard","line":48},{"title":"Ver discusiones","target":"https://steamcommunity.com/app/27020/discussions/","line":48},{"title":"Visitar el sitio web","target":"https://steamcommunity.com/linkfilter/?u=http%3A%2F%2Fwww.tale-of-tales.com%2FTheGraveyard%2F","line":48},{"title":"Ver historial de actualizaciones","target":"https://store.steampowered.com/newshub/?appids=27020&snr=1_5_9__408","line":48},{"title":"Leer noticias relacionadas","target":"https://store.steampowered.com/newshub/app/27020?snr=1_5_9__408","line":48}],"metadata":{"title":"The Graveyard en Steam","source":"https://store.steampowered.com/app/27020/The_Graveyard/","author":null,"published":null,"created":"2026-01-28","description":"The Graveyard es un juego muy corto. Tomas el rol de una anciana que visita un cementerio. Das un paseo, te sientas en un banco y escuchas una canción. Es más como un cuadro explorable que un juego en sí. Un experimento con poesía y narración pero sin palabras.","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"nb60lx","at":1780729791518},"key":"Clippings/The Graveyard en Steam.md"},
